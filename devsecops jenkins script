node {
    stage('Checkout') {
        git branch: 'main', url: 'https://github.com/Aswin9796/sample-python-app.git'
    }

    stage('Install Dependencies') {
        sh 'pip3 install --no-cache-dir -r requirements.txt'
    }

    stage('SonarQube Analysis') {
        withSonarQubeEnv('sonarserver') {
            withCredentials([string(credentialsId: 'sonar-auth-token', variable: 'SONAR_TOKEN')]) {
                sh '''
                export PATH=$PATH:/opt/sonar-scanner/bin
                sonar-scanner -Dsonar.projectKey=python-app \
                              -Dsonar.sources=src \
                              -Dsonar.host.url=$SONAR_HOST_URL \
                              -Dsonar.login=$SONAR_TOKEN
                '''
            }
        }
    }

    stage("Quality Gate") {
        script {
            waitForQualityGate abortPipeline: false, credentialsId: 'sonar-auth-token'
        }
    }

    stage('Build Docker Image') {
        sh '''
            # Stop and remove any existing container
            docker stop py-app || true
            docker rm py-app || true
            
            # Remove the old image to avoid conflicts
            docker rmi -f aswincontainer/py-app:latest || true
        '''

        sh 'docker build -t aswincontainer/py-app:latest .'
    }

    stage('Push to Docker Registry') {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-password', passwordVariable: 'dockerpass', usernameVariable: 'dockeruser')]) {
            sh '''
            echo "$dockerpass" | docker login -u "$dockeruser" --password-stdin
            docker push aswincontainer/py-app:latest
            '''
        }
    }

    stage('Scan Image with Trivy') {
        sh 'trivy image --exit-code 0 --severity HIGH,CRITICAL aswincontainer/py-app:latest'
    }

    stage('Deploy to Docker') {
        sh '''
            # Ensure no existing container is running before deployment
            docker stop py-app || true
            docker rm py-app || true
            
            # Run the new container
            docker run -d --name py-app -p 5001:5001 aswincontainer/py-app:latest
        '''
    }
}
